 accuracy = 0.9604  (+/- 0.0192)\nK =  9  ->  CV accuracy = 0.9670  (+/- 0.0155)\nK = 11  ->  CV accuracy = 0.9604  (+/- 0.0179)\n\nBest K = 9  (highest cross-validation accuracy)\n","output_type":"stream"}],"execution_count":22},{"cell_type":"code","source":"plt.figure(figsize=(7, 4.2))\nplt.plot(k_values, cv_scores, \"o-\", color=\"#0070C0\", lw=2, markersize=8)\nplt.scatter([best_k], [max(cv_scores)], color=\"#C0504D\", s=140, zorder=5,\n            label=f\"best K = {best_k}\")\nplt.title(\"Choosing K: Cross-Validation Accuracy vs K\")\nplt.xlabel(\"K (number of neighbours)\")\nplt.ylabel(\"mean CV accuracy\")\nplt.xticks(k_values)\nplt.grid(alpha=0.3)\nplt.legend()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-05T08:14:13.088558Z","iopub.execute_input":"2026-08-05T08:14:13.089951Z","iopub.status.idle":"2026-08-05T08:14:13.28491Z","shell.execute_reply.started":"2026-08-05T08:14:13.089904Z","shell.execute_reply":"2026-08-05T08:14:13.284044Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 700x420 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":23},{"cell_type":"code","source":"knn = KNeighborsClassifier(n_neighbors=best_k)\nknn.fit(X_train_s, y_train)                 # \"lazy\" fit - just stores the data\n\ny_pred = knn.predict(X_test_s)              # majority-vote predictions\n\n# probability of the MALIGNANT class, needed for ROC-AUC\nmal_col = list(knn.classes_).index(POS_LABEL)\ny_proba_mal = knn.predict_proba(X_test_s)[:, mal_col]\n\nprint(f\"Final model trained with K = {best_k}.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-05T08:14:54.769984Z","iopub.execute_input":"2026-08-05T08:14:54.771061Z","iopub.status.idle":"2026-08-05T08:14:54.783426Z","shell.execute_reply.started":"2026-08-05T08:14:54.771027Z","shell.execute_reply":"2026-08-05T08:14:54.782504Z"}},"outputs":[{"name":"stdout","text":"Final model trained with K = 9.\n","output_type":"stream"}],"execution_count":24},{"cell_type":"code","source":"acc  = accuracy_score(y_test, y_pred)\nprec = precision_score(y_test, y_pred, pos_label=POS_LABEL)\nrec  = recall_score(y_test, y_pred, pos_label=POS_LABEL)\nf1   = f1_score(y_test, y_pred, pos_label=POS_LABEL)\nauc  = roc_auc_score((y_test == POS_LABEL).astype(int), y_proba_mal)\n\nprint(f\"Accuracy : {acc:.4f}\")\nprint(f\"Precision: {prec:.4f}   (malignant as positive class)\")\nprint(f\"Recall   : {rec:.4f}   <- fraction of real cancers caught\")\nprint(f\"F1-score : {f1:.4f}\")\nprint(f\"ROC-AUC  : {auc:.4f}\")\n\nprint(\"\\nFull classification report:\")\nprint(classification_report(y_test, y_pred, target_names=[\"Malignant\", \"Benign\"]))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-05T08:15:08.6322Z","iopub.execute_input":"2026-08-05T08:15:08.633153Z","iopub.status.idle":"2026-08-05T08:15:08.669608Z","shell.execute_reply.started":"2026-08-05T08:15:08.633117Z","shell.execute_reply":"2026-08-05T08:15:08.668663Z"}},"outputs":[{"name":"stdout","text":"Accuracy : 0.9737\nPrecision: 1.0000   (malignant as positive class)\nRecall   : 0.9286   <- fraction of real cancers caught\nF1-score : 0.9630\nROC-AUC  : 0.9944\n\nFull classification report:\n              precision    recall  f1-score   support\n\n   Malignant       1.00      0.93      0.96        42\n      Benign       0.96      1.00      0.98        72\n\n    accuracy                           0.97       114\n   macro avg       0.98      0.96      0.97       114\nweighted avg       0.97      0.97      0.97       114\n\n","output_type":"stream"}],"execution_count":25},{"cell_type":"code","source":"cm = confusion_matrix(y_test, y_pred, labels=[0, 1])   # [malignant, benign]\n\nplt.figure(figsize=(5.0, 4.4))\nplt.imshow(cm, cmap=\"Blues\")\nlabels = [\"Malignant\", \"Benign\"]\nfor i in range(2):\n    for j in range(2):\n        color = \"white\" if cm[i, j] > cm.max() / 2 else \"#21295C\"\n        plt.text(j, i, cm[i, j], ha=\"ce